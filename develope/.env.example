# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (컨테이너 1개, 데이터베이스 2개) ---
# app_db      : 유저 로그인 데이터 + 프론트엔드 조회용 gold 요약 테이블 (Airflow와 무관)
# airflow_db  : Airflow 메타데이터
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=app_db
AIRFLOW_POSTGRES_DB=airflow_db

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_FERNET_KEY=
# webserver/scheduler/triggerer가 전부 같은 값을 써야 함 (다르면 로그 조회 403 에러)
AIRFLOW_SECRET_KEY=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# --- k3s ---
K3S_TOKEN=change_me

# --- External APIs ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ITCHIO_API_KEY=
OPENAI_API_KEY=
