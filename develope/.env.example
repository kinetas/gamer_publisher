# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (컨테이너 1개, 데이터베이스 2개) ---
# app_db      : 유저 로그인 데이터 + 프론트엔드 조회용 gold 요약 테이블 (Airflow와 무관)
# airflow_db  : Airflow 메타데이터
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=app_db
AIRFLOW_POSTGRES_DB=airflow_db

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_FERNET_KEY=
# webserver/scheduler/triggerer가 전부 같은 값을 써야 함 (다르면 로그 조회 403 에러)
AIRFLOW_SECRET_KEY=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# --- k3s ---
K3S_TOKEN=change_me

# --- External APIs ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# praw는 기본/일반적인 user-agent를 거부하거나 스로틀한다. 비워두면
# docker-compose.yml의 기본값(python:gamer-publisher:0.1.0 ...)을 그대로 쓴다.
REDDIT_USER_AGENT=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ITCHIO_API_KEY=
OPENAI_API_KEY=

# --- LLM (기본은 위 OPENAI_API_KEY로 실제 OpenAI) ---
# docker-compose.yml의 ollama 서비스(CPU 전용 로컬 서버) 등 OpenAI 호환
# 로컬 서버를 쓰려면 LLM_BASE_URL만 채우면 된다: http://ollama:11434/v1
# (같은 backend-net 안이라 서비스명으로 붙는다). 나머지 모델명은 그 서버에
# 실제로 받아둔(ollama pull 등) 모델 식별자와 정확히 일치해야 한다.
# 비워두면 gpt-4o-mini 등 OpenAI 기본값.
LLM_BASE_URL=
REPORTER_MODEL=
COPY_DESK_MODEL=
EDITORIAL_MODEL=
EMBEDDING_MODEL=
# 로컬 CPU 서버는 컨테이너 하나가 사실상 순차 처리라 낮게(예: 2) 잡는다.
# 비워두면 OpenAI 기준 기본값(8).
LLM_CONCURRENCY=

# --- LangSmith (선택) ---
# smith.langchain.com에서 발급받은 API 키. 채우고 LANGCHAIN_TRACING_V2=true로
# 켜면 코드 변경 없이 langgraph 실행이 자동으로 추적된다. 비워두면(기본) 추적 안 함.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gamer-publisher
